<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>Advanced Interactive Anime AI Companion</title>
<style>
body { font-family: Arial, sans-serif; background: #f0f0f0; display:flex; flex-direction:column; align-items:center; padding:20px; overflow:hidden; }
#background { position:absolute; width:100%; height:100%; z-index:-1; background:linear-gradient(#f0f0f0,#cceeff); animation: bgMove 10s linear infinite; }
@keyframes bgMove { 0%{background-position:0 0;} 100%{background-position:100% 100%;} }
#avatarContainer { position: relative; width: 200px; height: 300px; margin-bottom: 10px; animation: idle 3s infinite alternate; }
#avatarContainer img { position: absolute; top: 0; left: 0; width: 100%; transition: transform 0.1s; }
#hand { bottom:20px; left:50px; width:50px; }
@keyframes blink { 0%,90%,100%{opacity:1;} 95%{opacity:0;} }
@keyframes idle { 0%,100%{transform:translateY(0);} 50%{transform:translateY(2px);} }
#eyes { animation: blink 4s infinite; }
#chatBox { width: 400px; height: 300px; border: 2px solid #333; background: #fff; padding: 10px; overflow-y: scroll; margin-top:10px; }
#userInput { width: 300px; padding: 10px; margin-top:10px; }
#sendBtn,#clearMemoryBtn { padding: 10px; margin-top:5px; }
.message { margin:5px 0; }
.user { color: blue; }
.ai { color: green; }
#personalitySelect { margin-top:10px; padding:5px; }
</style>
</head>
<body>

<div id="background"></div>
<h1>Advanced Interactive Anime AI Companion</h1>

<div id="avatarContainer">
  <img id="body" src="anime_body.png" alt="Body">
  <img id="eyes" src="eyes.png" alt="Eyes">
  <img id="mouth" src="mouth_0.png" alt="Mouth">
  <img id="hand" src="hand_neutral.png" alt="Hand">
</div>

<select id="personalitySelect">
  <option value="cheerful">Cheerful</option>
  <option value="funny">Funny</option>
  <option value="friendly">Friendly</option>
</select>

<div id="chatBox"></div>
<input type="text" id="userInput" placeholder="Type something...">
<button id="sendBtn">Send</button>
<button id="clearMemoryBtn">Clear Memory</button>

<script>
const chatBox=document.getElementById('chatBox');
const userInput=document.getElementById('userInput');
const sendBtn=document.getElementById('sendBtn');
const clearMemoryBtn=document.getElementById('clearMemoryBtn');
const personalitySelect=document.getElementById('personalitySelect');
const avatarContainer=document.getElementById('avatarContainer');
const eyes=document.getElementById('eyes');
const mouth=document.getElementById('mouth');
const hand=document.getElementById('hand');

// Load memory
let chatMemory=JSON.parse(localStorage.getItem('chatMemory'))||[];
chatMemory.forEach(entry=>addMessage(entry.role,entry.content));
function saveMemory(){ localStorage.setItem('chatMemory',JSON.stringify(chatMemory)); }

// Blinking
function startBlinking(interval=4000){ clearInterval(eyes.blinkInterval); eyes.blinkInterval=setInterval(()=>{ eyes.src='eyes_closed.png'; setTimeout(()=>{eyes.src='eyes.png'},200); }, interval); }
startBlinking();

// Eyes follow cursor
document.addEventListener('mousemove',(e)=>{
  const rect=avatarContainer.getBoundingClientRect();
  const x=e.clientX-rect.left-rect.width/2;
  const y=e.clientY-rect.top-rect.height/2;
  eyes.style.transform=`translate(${x/20}px,${y/20}px)`;
  mouth.style.transform=`translate(${x/30}px,${y/30}px)`;
  hand.style.transform=`translate(${x/50}px,${y/50}px)`;
});

// Add message
function addMessage(sender,text){ const div=document.createElement('div'); div.classList.add('message',sender); div.textContent=text; chatBox.appendChild(div); chatBox.scrollTop=chatBox.scrollHeight; }

// Mouth animation
let mouthFrames=['mouth_0.png','mouth_1.png','mouth_2.png','mouth_3.png'];
function animateMouth(duration=2000){ let i=0; const interval=setInterval(()=>{mouth.src=mouthFrames[i%mouthFrames.length]; i++;},100); setTimeout(()=>{clearInterval(interval); mouth.src=mouthFrames[0];},duration); }

// Expressions
function setExpression(expression){
  switch(expression){
    case 'happy': eyes.src='eyes_happy.png'; mouthFrames=['mouth_happy_0.png','mouth_happy_1.png','mouth_happy_2.png']; break;
    case 'sad': eyes.src='eyes_sad.png'; mouthFrames=['mouth_sad_0.png','mouth_sad_1.png']; break;
    case 'surprised': eyes.src='eyes_surprised.png'; mouthFrames=['mouth_surprised_0.png','mouth_surprised_1.png']; break;
    default: eyes.src='eyes.png'; mouthFrames=['mouth_0.png','mouth_1.png','mouth_2.png','mouth_3.png'];
  }
}

// Gestures
function headTilt(dir='left'){ avatarContainer.style.transform=`rotate(${dir==='left'?'-5deg':'5deg'})`; setTimeout(()=>{avatarContainer.style.transform='rotate(0deg)'},500); }
function bodySway(duration=1000){ avatarContainer.style.transition=`transform ${duration/1000}s ease-in-out`; avatarContainer.style.transform='translateY(-3px)'; setTimeout(()=>{avatarContainer.style.transform='translateY(0px)'},duration); }
function headNod(){ const rand=Math.random(); const move = rand > 0.5 ? -3 : -5; avatarContainer.style.transform=`translateY(${move}px)`; setTimeout(()=>{avatarContainer.style.transform='translateY(0px)'},300); }
function handGesture(emotion){ if(!hand) return; const rand=Math.random(); let rotate=0; if(emotion==='happy') rotate = rand > 0.5 ? 20 : 10; if(emotion==='surprised') rotate = rand > 0.5 ? -15 : -25; hand.style.transform=`rotate(${rotate}deg)`; setTimeout(()=>{hand.style.transform='rotate(0deg)'},500); }
function setBlinkSpeed(emotion){ let interval=4000; if(emotion==='surprised') interval=1500; if(emotion==='happy') interval=3000; if(emotion==='shy') interval=2000; startBlinking(interval); }

// Apply emotion
function applyEmotion(emotion){
  switch(emotion){
    case 'happy': setExpression('happy'); bodySway(800); headNod(); handGesture('happy'); setBlinkSpeed('happy'); break;
    case 'sad': setExpression('sad'); bodySway(500); handGesture('sad'); setBlinkSpeed('neutral'); break;
    case 'surprised': setExpression('surprised'); bodySway(1000); headNod(); handGesture('surprised'); setBlinkSpeed('surprised'); break;
    case 'shy': setExpression('neutral'); bodySway(200); handGesture('shy'); setBlinkSpeed('shy'); break;
    case 'excited': setExpression('happy'); bodySway(1200); headNod(); handGesture('happy'); setBlinkSpeed('excited'); break;
    default: setExpression('neutral'); handGesture('neutral'); setBlinkSpeed('neutral');
  }
}

// AI response with emotion
async function getAIResponseWithEmotion(message, personality, memory){
  const apiKey='e55afda97dfd89556dc6542c14de31d4760d44a9'; // Replace with your key
  const systemPrompt=`You are a ${personality} anime AI companion. Respond friendly, teen-appropriate, then output JSON {"emotion":"happy/sad/surprised/shy/excited/neutral"} at the end.`;
  const data={ model:"gpt-3.5-turbo", messages:[{role:"system",content:systemPrompt}, ...memory, {role:"user",content:message}] };
  const response=await fetch("https://api.openai.com/v1/chat/completions",{method:"POST", headers:{"Content-Type":"application/json","Authorization":`Bearer ${apiKey}`}, body:JSON.stringify(data)});
  const result=await response.json();
  const fullText=result.choices[0].message.content;
  const match=fullText.match(/([\s\S]*?)\n(\{.*\})$/);
  let text=fullText, emotion="neutral";
  if(match){ text=match[1].trim(); try{emotion=JSON.parse(match[2]).emotion}catch(e){emotion="neutral"} }
  return {text, emotion};
}

// Speak
function speakText(text,emotion){
  if('speechSynthesis' in window){
    const utterance=new SpeechSynthesisUtterance(text);
    utterance.lang='en-US';
    const duration=text.split(' ').length*200;
    utterance.onstart=()=>{ animateMouth(duration); applyEmotion(emotion); }
    speechSynthesis.speak(utterance);
  }
}

// Send message
sendBtn.onclick=async()=>{
  const message=userInput.value;
  if(!message) return;
  addMessage('user',message);
  chatMemory.push({role:'user',content:message}); saveMemory(); userInput.value='';
  const responseData=await getAIResponseWithEmotion(message,personalitySelect.value,chatMemory);
  addMessage('ai',responseData.text);
  chatMemory.push({role:'ai',content:responseData.text}); saveMemory();
  speakText(responseData.text,responseData.emotion);
}

// Clear memory
clearMemoryBtn.onclick=()=>{ localStorage.removeItem('chatMemory'); chatBox.innerHTML=''; chatMemory=[]; }

// Idle gestures
setInterval(()=>{
  const rand=Math.random();
  if(rand<0.25) headTilt(Math.random()>0.5?'left':'right');
  else if(rand<0.5) bodySway(500 + Math.random()*500);
  else if(rand<0.75) headNod();
  else handGesture('neutral');
}, 4000 + Math.random()*2000);
</script>

</body>
</html>
